# Application settings
APP_NAME="AI Portfolio API"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage paths
DATA_DIR=data
ARTIFACTS_DIR=artifacts

# Optional LLM Provider API Keys (never commit real secrets in .env)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
